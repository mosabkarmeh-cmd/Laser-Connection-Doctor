; ============================================================================
; CH340 / CH341 USB to Serial Driver INF (WCH QinHeng Electronics)
; Compatible: Windows 7 / 8 / 10 / 11 (x64 / x86)
; Hardware IDs: USB\VID_1A86&PID_7523, USB\VID_1A86&PID_5523
; ============================================================================

[Version]
Signature="$WINDOWS NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%PROVIDER%
DriverVer=01/30/2019,3.5.2019.1
CatalogFile=CH341SER.CAT

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%PROVIDER%=WCH,NTamd64,NTx86

[WCH.NTamd64]
%CH340.DeviceDesc%=CH341_Install,USB\VID_1A86&PID_7523
%CH341.DeviceDesc%=CH341_Install,USB\VID_1A86&PID_5523
%CH340G.DeviceDesc%=CH341_Install,USB\VID_1A86&PID_7522

[WCH.NTx86]
%CH340.DeviceDesc%=CH341_Install,USB\VID_1A86&PID_7523
%CH341.DeviceDesc%=CH341_Install,USB\VID_1A86&PID_5523
%CH340G.DeviceDesc%=CH341_Install,USB\VID_1A86&PID_7522

[CH341_Install.NT]
CopyFiles=CH341_Files

[CH341_Files]
CH341S64.SYS

[CH341_Install.NT.Services]
AddService=CH341SER,2,CH341_Service

[CH341_Service]
DisplayName=%CH341.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\CH341S64.SYS

[Strings]
PROVIDER="Jiangsu Qinheng Microelectronics Co., Ltd."
CH340.DeviceDesc="USB-SERIAL CH340 (Legacy Laser/CNC Port)"
CH341.DeviceDesc="USB-SERIAL CH341 (Laser Controller Port)"
CH340G.DeviceDesc="USB-SERIAL CH340G Port"
CH341.ServiceDesc="CH341 USB to Serial Port Driver Service"
